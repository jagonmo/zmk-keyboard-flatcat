#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/led/led.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan     = &kscan0;
        zmk,underglow = &led_strip;
        zmk,battery   = &vbatt;
    };

    /* GPIO regulator powering the WS2812 strip (P0.29) — same on both halves. */
    rgb_pro_pwr: rgb_pro_pwr {
        compatible     = "regulator-fixed";
        regulator-name = "rgb_pro_pwr";
        enable-gpios   = <&gpio0 29 GPIO_ACTIVE_LOW>;
        regulator-boot-on;
    };

    kscan0: kscan {
        compatible      = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio1 6  GPIO_ACTIVE_HIGH>
            , <&gpio1 4  GPIO_ACTIVE_HIGH>
            , <&gpio1 2  GPIO_ACTIVE_HIGH>
            , <&gpio1 1  GPIO_ACTIVE_HIGH>
            , <&gpio1 3  GPIO_ACTIVE_HIGH>
            , <&gpio1 0  GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio0 28 GPIO_ACTIVE_HIGH>
            , <&gpio0 2  GPIO_ACTIVE_HIGH>
            , <&gpio0 3  GPIO_ACTIVE_HIGH>
            , <&gpio1 15 GPIO_ACTIVE_HIGH>
            , <&gpio1 13 GPIO_ACTIVE_HIGH>
            , <&gpio1 10 GPIO_ACTIVE_HIGH>
            , <&gpio1 11 GPIO_ACTIVE_HIGH>
            ;
    };

    /* Full 158-key transform, shared by both halves. The right half shifts
       its local matrix into columns 14-27 with col-offset. */
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <28>;
        rows    = <6>;

        map = <
    RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
    RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
    RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
    RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
    RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
    RC(5,0) RC(5,1) RC(5,2) RC(5,6) RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13)
    RC(0,14) RC(0,15) RC(0,16) RC(0,17) RC(0,18) RC(0,19) RC(0,20) RC(0,21) RC(0,22) RC(0,23) RC(0,24) RC(0,25) RC(0,26) RC(0,27)
    RC(1,14) RC(1,15) RC(1,16) RC(1,17) RC(1,18) RC(1,19) RC(1,20) RC(1,21) RC(1,22) RC(1,23) RC(1,24) RC(1,25) RC(1,26) RC(1,27)
    RC(2,14) RC(2,15) RC(2,16) RC(2,17) RC(2,18) RC(2,19) RC(2,20) RC(2,21) RC(2,22) RC(2,23) RC(2,24) RC(2,25) RC(2,26) RC(2,27)
    RC(3,14) RC(3,15) RC(3,16) RC(3,17) RC(3,18) RC(3,19) RC(3,20) RC(3,21) RC(3,22) RC(3,23) RC(3,24) RC(3,25) RC(3,26) RC(3,27)
    RC(4,14) RC(4,15) RC(4,16) RC(4,17) RC(4,18) RC(4,19) RC(4,20) RC(4,21) RC(4,22) RC(4,23) RC(4,24) RC(4,25) RC(4,26) RC(4,27)
    RC(5,14) RC(5,15) RC(5,16) RC(5,20) RC(5,23) RC(5,24) RC(5,25) RC(5,26) RC(5,27)
        >;
    };

    leds {
        compatible = "gpio-leds";
        blue_led: led_0 {
            gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
            label = "Blue LED";
        };
    };

    behaviors {
        rgb_pro: rgbpro {
            compatible     = "zmk,behavior-rgb-pro";
            #binding-cells = <2>;
        };
    };

    vbatt: vbatt {
        compatible  = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>;
        output-ohms = <2000000>;
        full-ohms   = <(2000000 + 806000)>;
    };
};

&pinctrl {
    spi3_default: spi3_default {
        group1 { psels = <NRF_PSEL(SPIM_MOSI, 0, 19)>; };
    };
    spi3_sleep: spi3_sleep {
        group1 { psels = <NRF_PSEL(SPIM_MOSI, 0, 19)>; low-power-enable; };
    };
};

&spi3 {
    compatible    = "nordic,nrf-spim";
    status        = "okay";
    pinctrl-0     = <&spi3_default>;
    pinctrl-1     = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible        = "worldsemi,ws2812-spi";
        reg               = <0>;
        spi-max-frequency = <4000000>;
        chain-length      = <79>;
        spi-one-frame     = <0x70>;
        spi-zero-frame    = <0x40>;
        color-mapping     = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
